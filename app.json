{
  "expo": {
    "name": "WakeMeUp",
    "slug": "wake-me-up",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/wake-me-up.png",
    "scheme": "wakemeupapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to trigger alarms when you reach destinations.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need background location access to trigger alarms even when the app is closed.",
        "NSLocationAlwaysUsageDescription": "We need background location access to trigger alarms even when the app is closed.",
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      },
      "bundleIdentifier": "com.suvro.wakemeup"
    },
    "android": {
      "versionCode": 7,
      "package": "suvro.gfz.wakemeup",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "VIBRATE",
        "SYSTEM_ALERT_WINDOW",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "./app.plugin.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow WakeMeUp to use your location to trigger destination alarms.",
          "locationAlwaysPermission": "Allow WakeMeUp to use your location in the background to trigger alarms.",
          "locationWhenInUsePermission": "Allow WakeMeUp to use your location to set up alarms.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#dc2626",
          "sounds": [
            "./assets/audio/alarm-tones/alarm1.mp3",
            "./assets/audio/alarm-tones/alarm2.wav",
            "./assets/audio/alarm-tones/alarm3.mp3"
          ],
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3321d9ca-6120-42f2-a4f2-4df23f17471c"
      }
    }
  }
}